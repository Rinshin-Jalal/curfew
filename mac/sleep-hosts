#!/bin/sh
# The only thing Sleep may run as root (sudoers allows exactly "on" and "off").
# Puts one marked block at the top of /etc/hosts, or takes it out again byte for byte, then flushes DNS.
# Edit the list here and re-run install.sh.
set -eu
PATH=/usr/bin:/bin:/usr/sbin:/sbin
HOSTS=/etc/hosts
BEGIN="# >>> sleep: blocked during the lock window"
END="# <<< sleep"
DOMAINS="
youtube.com www.youtube.com m.youtube.com youtu.be
instagram.com www.instagram.com
x.com www.x.com twitter.com www.twitter.com
reddit.com www.reddit.com old.reddit.com
tiktok.com www.tiktok.com
facebook.com www.facebook.com
netflix.com www.netflix.com
twitch.tv www.twitch.tv
news.ycombinator.com
"

case "${1:-}" in on | off) ;; *) echo "usage: $0 on|off" >&2; exit 2 ;; esac

tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
{
  if [ "$1" = on ]; then
    echo "$BEGIN"
    for d in $DOMAINS; do printf '0.0.0.0 %s\n:: %s\n' "$d" "$d"; done
    echo "$END"
  fi
  # everything except an existing block, so "on" is idempotent and "off" restores the original
  awk -v b="$BEGIN" -v e="$END" '$0 == b { skip = 1; next } skip && $0 == e { skip = 0; next } !skip' "$HOSTS"
} >"$tmp"
cat "$tmp" >"$HOSTS" # in place: keeps owner, mode and inode
dscacheutil -flushcache
killall -HUP mDNSResponder 2>/dev/null || true
